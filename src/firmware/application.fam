# NEQ6 Current Logger — Flipper Zero FAP (Momentum / official SDK actual)
#
# Compilación con ufbt:
#   ufbt update                 # descarga el SDK que coincide con tu firmware
#   ufbt fap_neq6_current_logger
#   ufbt launch
#
# No se fija ApiVersion: se compila contra el nivel de API del SDK descargado,
# evitando errores "ApiTooNew". Las dependencias son las mismas que usa la app
# oficial "Bluetooth Serial" (que ES un FAP externo), por lo que los símbolos
# ble_profile_serial_* están garantizados en la tabla de API exportada.

App(
    appid="neq6_current_logger",
    name="NEQ6 Current",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="neq6_logger_app",
    requires=[
        "gui",
        "bt",
    ],
    stack_size=4 * 1024,
    order=10,
    fap_category="Tools",
    fap_description="Logger de corriente del motor AR de una NEQ6 (shunt 0.323 R) con streaming BLE",
)
